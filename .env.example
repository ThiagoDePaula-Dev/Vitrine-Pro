# Supabase (URL e anon key são públicas; protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE servidor — nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# IA (SOMENTE servidor)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# URL pública do site (links, QR Code, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal do hash de IP das avaliações (string aleatória longa; SOMENTE servidor)
REVIEW_IP_SALT=

# (opcional) testes de RLS — SOMENTE um Supabase de teste
RLS_SUPABASE_URL=
RLS_ANON_KEY=
RLS_SERVICE_KEY=
